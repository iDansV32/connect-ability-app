# Copy this file to `.env` and fill in real values. The .env file is
# gitignored; never commit it.

# LinkedIn account credentials for local fallback when the macOS keychain /
# Windows Credential Manager doesn't have a saved password yet. In normal
# use the Settings → LinkedIn accounts page saves the password into the OS
# credential store via keytar; these are only a backup.
LINKEDIN_EMAIL=
LINKEDIN_PASSWORD=

# Token + port for the optional local HTTP/MCP server used by external
# integrations (Slack handler, OpenClaw, etc.). Leave blank if you're not
# exposing the MCP API.
CONNECT_API_TOKEN=
CONNECT_API_PORT=3030
